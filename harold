function init() {

# create output folder
if [ -d $WORKDIR ];then err "Folder $WORKDIR already exists!"; fi
log_step "[init] Preparing workdir"
mkdir -p $WORKDIR

# copy config resources
cp -r ${PIPELINE_HOME}/config $WORKDIR/

log_info "Editing config.yaml with the following parameters:"
log_info "Pipeline Dir: $PIPELINE_HOME"
log_info "Git Commit/Tag: $GIT_COMMIT_TAG"
log_info "Work Dir: $WORKDIR"
log_info "Host: $HOST"
log_info "Additives: $ADDITIVES"
log_info "Viruses: $VIRUSES"
log_info "Manifest: $MANIFEST"
log_info "Contrasts: ${CONTRASTS:-<not provided>}"
log_info "Temp Dir: $TEMP_DIR"
log_info "Refs Dir: $REFS_DIR"
log_info "Cluster Profile: $CLUSTER_PROFILE"
log_info "Singularity Cache Dir: $APPTAINER_CACHE_DIR"
log_info "Singularity Tmp Dir: $APPTAINER_TMP_DIR"
log_info "Singularity Pull Dir: $APPTAINER_PULL_DIR"
log_info "Editing file $WORKDIR/config.yaml"

# copy config template and samples files
if [ ! -f $CONFIGFILE ];then
sed -e "
  s|PIPELINE_HOME|$PIPELINE_HOME|g;
  s|WORKDIR|$WORKDIR|g;
  s|HOST|$HOST|g;
  s|ADDITIVES|$ADDITIVES|g;
  s|VIRUSES|$VIRUSES|g;
  s|TEMP_DIR|$TEMP_DIR|g;
  s|REFS_DIR|$REFS_DIR|g;
  s|KRAKEN2_DB|$KRAKEN2_DB|g;
  s|CLUSTER_PROFILE|$CLUSTER_PROFILE|g
" ${PIPELINE_HOME}/config/config.yaml > $CONFIGFILE
else
  err "File $WORKDIR/config.yaml already exists!"
fi

log_ok "Completed writing $WORKDIR/config.yaml"

if [ ! -f $WORKDIR/samples.tsv ];then
# copy manifest file ... follow symlink
cp -L $MANIFEST $WORKDIR/samples.tsv
fi

if [ -n "$CONTRASTS" ];then
# copy contrasts file ... follow symlink
cp -L $CONTRASTS $WORKDIR/contrasts.tsv
log_ok "Copied contrasts file to $WORKDIR/contrasts.tsv"
fi

#create log and stats folders
if [ ! -d $WORKDIR/logs ]; then mkdir -p $WORKDIR/logs;log_ok "Logs Dir: $WORKDIR/logs";fi
if [ ! -d $WORKDIR/stats ];then mkdir -p $WORKDIR/stats;log_ok "Stats Dir: $WORKDIR/stats";fi

log_ok "Initialization completed for $WORKDIR"
log_next "Edit $WORKDIR/config.yaml and $WORKDIR/samples.tsv, then run: harold -w=$WORKDIR -m=dryrun"

}

