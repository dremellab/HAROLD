# check whether required dependencies are in the path
function check_deps() {
  for dep in python snakemake singularity; do
    command -v $dep &> /dev/null || err "$dep not found in PATH"
  done
}

# load modules if available, or check whether they're in the path
function load_modules() {
  log_step "[runcheck] Loading modules"
  log_info "$MODULE_LOAD"
  eval $MODULE_LOAD
  module list
  log_info "python:      $(which python)"
  log_info "singularity: $(which singularity)"
  log_info "snakemake:   $(which snakemake)"
  log_info "PATH:        $PATH"
  check_deps
  log_ok "Modules loaded"
}

##########################################################################################
# RUNCHECK ... check essential files and load required packages
##########################################################################################

function runcheck(){
  check_essential_files
  load_modules
  # CLUSTER_PROFILE="${WORKDIR}/${CLUSTER_PROFILE}"
  cd $WORKDIR
  write_failure_helpers_lib
}

##########################################################################################
# DRYRUN ... also run automatically before actual run
##########################################################################################

function dryrun() {
  log_step "[dryrun] Running preflight checks"
  runcheck
  log_ok "Runcheck completed"
  set_singularity_binds
  timestamp=$(date +"%y%m%d%H%M%S")
  nfiles=$(find ${WORKDIR} -maxdepth 1 -name "dryrun.*.log"|wc -l)
  if [ "$nfiles" != "0" ];then
    for f in $(ls ${WORKDIR}/dryrun.*.log);do
      mv $f ${WORKDIR}/stats/
    done
  fi
  log_divider
  # Pipeline as an `if` condition (not a bare statement) so errexit is
  # suppressed for this line intrinsically, regardless of how dryrun() itself
  # is invoked at the call site -- unlike relying on the caller always doing
  # `dryrun && exit 0`, which only works by accident of where it's called from.
  if run "--dry-run" | tee ${WORKDIR}/dryrun.${timestamp}.log; then
    rc=0
  else
    rc=${PIPESTATUS[0]}
  fi
  log_divider
  if [ "$rc" -ne 0 ]; then
    log_error "Dry-run failed (exit code ${rc}). See log: ${WORKDIR}/dryrun.${timestamp}.log"
    warn_if_already_running
    return $rc
  fi
  log_ok "Dry-run completed. Log: ${WORKDIR}/dryrun.${timestamp}.log"
  if [ -f "${WORKDIR}/pipeline.running" ]; then
    # A run appears to already be active -- don't invite the user to submit
    # another one; harold -m=run would refuse it anyway (check_not_already_running).
    warn_if_already_running
  elif ! grep -q "Nothing to be done" ${WORKDIR}/dryrun.${timestamp}.log; then
    log_next "Submit run with: harold -w=$WORKDIR -m=run"
  fi
}

function touch() {
  log_step "[touch] Touching output files"
  runcheck
  timestamp=$(date +"%y%m%d%H%M%S")
  # See dryrun() for why this is an `if` condition rather than a bare statement.
  if run "--touch" | tee ${WORKDIR}/touch.${timestamp}.log; then
    rc=0
  else
    rc=${PIPESTATUS[0]}
  fi
  if [ "$rc" -ne 0 ]; then
    log_error "Touch failed (exit code ${rc}). See log: ${WORKDIR}/touch.${timestamp}.log"
    return $rc
  fi
  log_ok "Touch completed. Log: ${WORKDIR}/touch.${timestamp}.log"
}

##########################################################################################
# UNLOCK
##########################################################################################

function unlock() {
  log_step "[unlock] Unlocking workdir"
  runcheck
  check_not_already_running
  if ! run "--unlock"; then
    rc=$?
    log_error "Unlock failed (exit code ${rc})"
    return $rc
  fi
  log_ok "Workdir unlocked"
}

##########################################################################################
# SET SINGULARITY BINDS ... bind required singularity folders appropriately
##########################################################################################

function set_singularity_binds() {
  binds=$( $PIPELINE_HOME/workflow/scripts/_find_singularity_bind_paths.py ${WORKDIR}/config.yaml ${WORKDIR}/samples.tsv)
  if [[ -z "${EXTRA_SINGULARITY_BINDS:-}" ]]; then
	SINGULARITY_BINDS="-B $binds"
  else
  	SINGULARITY_BINDS="-B $EXTRA_SINGULARITY_BINDS,$binds"
  fi
}
##########################################################################################
# PRINT SINGULARITY BINDS ... print bound singularity folders for debugging
##########################################################################################

function printbinds(){
  set_singularity_binds
  echo $SINGULARITY_BINDS
}

##########################################################################################
# RUNLOCAL ... run directly on local interactive node ... no submission to SLURM
##########################################################################################

function runlocal() {
  log_step "[runlocal] Starting local interactive execution"
  runcheck
  check_not_already_running
  set_singularity_binds
  if [ "$SLURM_JOB_ID" == "" ];then err "runlocal can only be done on an interactive node"; exit 1; fi
  log_divider
  write_pipeline_state_marker running "runlocal_started"

  # Background loop: tails the tee'd snakemake log below for Snakemake's own
  # "N of M steps (P%) done" lines and periodically writes a human-readable
  # progress summary into pipeline.running, mirroring the SLURM head job's
  # _progress_monitor (see the sbatch template built in run_head_job()).
  runlocal_log="${WORKDIR}/runlocal.$(date +%y%m%d%H%M%S).log"
  marker="${WORKDIR}/pipeline.running"
  _runlocal_progress_monitor() {
    local raw done_n total_n pct remaining updated
    while true; do
      [[ -f "$marker" ]] || break
      if [[ -f "$runlocal_log" ]]; then
        raw=$(grep -oP '[0-9]+ of [0-9]+ steps \([0-9]+%\) done' "$runlocal_log" 2>/dev/null | tail -1 || true)
        if [[ -n "$raw" ]]; then
          done_n=$(printf '%s' "$raw" | grep -oP '^\d+' || true)
          total_n=$(printf '%s' "$raw" | grep -oP '(?<=of )\d+' || true)
          pct=$(printf '%s' "$raw" | grep -oP '\d+(?=%)' || true)
          if [[ -n "$done_n" && -n "$total_n" && -n "$pct" ]]; then
            remaining=$(( total_n - done_n ))
            (( remaining < 0 )) && remaining=0
            updated=$(date '+%Y-%m-%d %H:%M:%S')
            printf 'Progress : %s / %s steps complete (%s%%)\nRemaining: %s steps\nUpdated  : %s\n' \
              "$done_n" "$total_n" "$pct" "$remaining" "$updated" > "$marker"
          fi
        fi
      fi
      sleep 60
    done
  }
  _runlocal_progress_monitor &
  monitor_pid=$!

  # Pipeline as an `if` condition, using PIPESTATUS to get run()'s exit code
  # rather than tee's -- see dryrun() for why.
  if run "local" | tee "$runlocal_log"; then
    rc=0
  else
    rc=${PIPESTATUS[0]}
  fi

  kill "$monitor_pid" 2>/dev/null || true
  wait "$monitor_pid" 2>/dev/null || true

  if [ "$rc" -eq 0 ]; then
    # Re-derive the final step count from the log and report it as N/N
    # (100%, 0 remaining) rather than the monitor's last (up to 60s stale)
    # snapshot.
    final_content=""
    final_raw=$(grep -oP '[0-9]+ of [0-9]+ steps \([0-9]+%\) done' "$runlocal_log" 2>/dev/null | tail -1 || true)
    if [[ -n "$final_raw" ]]; then
      final_total=$(printf '%s' "$final_raw" | grep -oP '(?<=of )\d+' || true)
      if [[ -n "$final_total" ]]; then
        final_content=$(printf 'Progress : %s / %s steps complete (100%%)\nRemaining: 0 steps\nUpdated  : %s\n' \
          "$final_total" "$final_total" "$(date '+%Y-%m-%d %H:%M:%S')")
      fi
    fi
    write_pipeline_state_marker completed "runlocal_succeeded" "" "$final_content"
    log_ok "Local run completed successfully"
  else
    # Preserve whatever progress snapshot the monitor last wrote (instead of
    # losing it) so pipeline.failed shows how far the run got.
    last_progress=$(cat "${WORKDIR}/pipeline.running" 2>/dev/null || true)

    # Enrich pipeline.failed/pipeline.status.json with which job(s) failed --
    # see write_failure_helpers_lib/extract_failed_rules_digest for how.
    failed_digest=""
    if [[ -f "${WORKDIR}/.harold_failure_helpers.sh" ]]; then
      source "${WORKDIR}/.harold_failure_helpers.sh"
      failed_digest=$(extract_failed_rules_digest "$runlocal_log" || true)
    fi
    num_failed=0
    failed_rules_json="[]"
    combined_content="$last_progress"
    if [[ -n "$failed_digest" ]]; then
      num_failed=$(printf '%s\n' "$failed_digest" | grep -c .)
      json_parts=()
      while IFS= read -r dl; do
        [[ -n "$dl" ]] && json_parts+=("\"$(json_escape "$dl")\"")
      done <<< "$failed_digest"
      failed_rules_json="[$(IFS=,; echo "${json_parts[*]}")]"
      combined_content="${combined_content}
${num_failed} job(s) failed:
${failed_digest}"
    fi

    write_pipeline_state_marker failed "runlocal_failed" "" "$combined_content" "$num_failed" "$failed_rules_json"
    log_error "Local run failed (exit code ${rc})"
    exit $rc
  fi
}

##########################################################################################
# RUNSLURM ... submit head job to slurm which will spawn other jobs on SLURM
##########################################################################################

function runslurm() {
  log_step "[run] Preparing SLURM submission"
  runcheck
  check_not_already_running
  set_singularity_binds
  timestamp=$(date +"%y%m%d%H%M%S")
  # Export PROFILE for use inside the head sbatch job (Snakemake expects this env var)
  EXPORT_PROFILE_CMD="export PROFILE=\"${WORKDIR}/config/${CLUSTER_PROFILE}\""

  # Create an sbatch wrapper that will run the snakemake head job on the scheduler.
  SBATCH_SCRIPT="${WORKDIR}/run_head_job.sbatch"
  # Use 2 CPUs, 40G memory, 3 days walltime as requested.
  # Include partition if set.
  if [[ -n "${PARTITION}" ]]; then
    PART_OPT="--partition=${PARTITION}"
  else
    PART_OPT=""
  fi

  cat > ${SBATCH_SCRIPT} <<-"SBATCH_EOF"
#!/bin/bash
# Auto-generated by HAROLD wrapper
#SBATCH --cpus-per-task=2
#SBATCH --mem=40G
#SBATCH --time=3-00:00:00
#SBATCH --account=dremel_lab
#SBATCH --job-name=harold_head_job
#SBATCH --output=__WORKDIR__/slurm-%j.out
__PART_OPTION__

set -euo pipefail

# Isolate from any personal ~/.local pip --user packages (see top of harold wrapper
# for why); must be set here too since this script runs as its own SLURM job.
export PYTHONNOUSERSITE=1

# Assigned via sed substitution (not interpolated directly into the JSON heredoc
# below) so that _json_escape can sanitize them at runtime -- GIT_COMMIT_TAG in
# particular always embeds a literal tab (see get_git_commitid_tag in the harold
# wrapper), which would otherwise produce invalid JSON.
VERSION="__VERSION__"
GIT_COMMIT_TAG="__GIT_COMMIT_TAG__"

function _json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\t' '  '
}

function _write_pipeline_state_marker() {
# Args: state reason [job_id] [content] [num_failed_rules] [failed_rules_json]
# NOTE: kept in sync with write_pipeline_state_marker in the harold wrapper
# above -- see the comment there.
  local state="$1"
  local reason="${2:-}"
  local job_id="${3:-${SLURM_JOB_ID:-NA}}"
  local content="${4:-}"
  local num_failed_rules="${5:-0}"
  local failed_rules_json="${6:-[]}"
  local now_utc host sidecar sidecar_tmp
  now_utc=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  host=$(hostname 2>/dev/null || echo "unknown")
  sidecar="__WORKDIR__/pipeline.status.json"
  sidecar_tmp="${sidecar}.tmp.$$"
  # Create the new marker before removing the old ones -- see the wrapper's
  # write_pipeline_state_marker for why.
  # If content was supplied (e.g. a final/last-known progress summary), write
  # it into the marker instead of leaving the marker empty.
  if [[ -n "$content" ]]; then
    printf '%s' "$content" > "__WORKDIR__/pipeline.${state}"
  else
    : > "__WORKDIR__/pipeline.${state}"
  fi
  for other_state in running completed failed canceled; do
    [[ "${other_state}" == "${state}" ]] && continue
    rm -f "__WORKDIR__/pipeline.${other_state}"
  done
  cat > "${sidecar_tmp}" << JSON
{
  "pipeline": "HAROLD",
  "version": "$(_json_escape "${VERSION}")",
  "git_commit_tag": "$(_json_escape "${GIT_COMMIT_TAG}")",
  "state": "$(_json_escape "${state}")",
  "reason": "$(_json_escape "${reason}")",
  "runmode": "run",
  "workdir": "__WORKDIR__",
  "slurm_job_id": "$(_json_escape "${job_id}")",
  "host": "$(_json_escape "${host}")",
  "num_failed_rules": ${num_failed_rules:-0},
  "failed_rules": ${failed_rules_json:-[]},
  "timestamp_utc": "${now_utc}"
}
JSON
  mv "${sidecar_tmp}" "${sidecar}"
}

trap '_write_pipeline_state_marker canceled "signal_SIGTERM"; exit 130' SIGTERM
trap '_write_pipeline_state_marker canceled "signal_SIGINT"; exit 130' SIGINT

cd __WORKDIR__

# Shared failed-job-digest parser, written by write_failure_helpers_lib() in
# the harold wrapper before this script was submitted -- see that function
# and extract_failed_rules_digest for what it does and why. Guarded (rather
# than a bare `source`) so a missing/unwritable lib file -- which should never
# happen, but this enrichment must never be able to abort the run under
# `set -e` -- just silently disables the digest instead.
if [[ -f "__WORKDIR__/.harold_failure_helpers.sh" ]]; then
  source "__WORKDIR__/.harold_failure_helpers.sh"
fi

# Export singularity cache dir if configured
__EXPORT_SING_CACHE_CMD__

# Export PROFILE so Snakemake/profile code can find the profile directory
__EXPORT_PROFILE_CMD__

# Load modules or conda if configured
__MODULE_LOAD_CMD__

echo "------------------------------------------------------------------"
echo "STEP  [head_job] Starting Snakemake head process"
echo "------------------------------------------------------------------"

# ── Progress monitor ─────────────────────────────────────────────────
# Background loop: waits for this job's own stdout (slurm-<jobid>.out, which
# is where Snakemake's own "N of M steps (P%) done" lines land), then
# periodically writes a human-readable progress summary into
# pipeline.running so `cat pipeline.running` shows live progress.
_progress_monitor() {
  local logfile="__WORKDIR__/slurm-${SLURM_JOB_ID}.out"
  local marker="__WORKDIR__/pipeline.running"
  local waited=0
  local max_wait=300
  local raw done_n total_n pct remaining updated

  while [[ ! -f "$logfile" && "$waited" -lt "$max_wait" ]]; do
    [[ -f "$marker" ]] || return 0
    sleep 10
    waited=$(( waited + 10 ))
  done

  while true; do
    [[ -f "$marker" ]] || break
    if [[ -f "$logfile" ]]; then
      raw=$(grep -oP '[0-9]+ of [0-9]+ steps \([0-9]+%\) done' "$logfile" 2>/dev/null | tail -1 || true)
      if [[ -n "$raw" ]]; then
        done_n=$(printf '%s' "$raw" | grep -oP '^\d+' || true)
        total_n=$(printf '%s' "$raw" | grep -oP '(?<=of )\d+' || true)
        pct=$(printf '%s' "$raw" | grep -oP '\d+(?=%)' || true)
        if [[ -n "$done_n" && -n "$total_n" && -n "$pct" ]]; then
          remaining=$(( total_n - done_n ))
          (( remaining < 0 )) && remaining=0
          updated=$(date '+%Y-%m-%d %H:%M:%S')
          printf 'Progress : %s / %s steps complete (%s%%)\nRemaining: %s steps\nUpdated  : %s\n' \
            "$done_n" "$total_n" "$pct" "$remaining" "$updated" > "$marker"
        fi
      fi
    fi
    sleep 60
  done
}
_progress_monitor &
_monitor_pid=$!
# ─────────────────────────────────────────────────────────────────────

# Run snakemake (head job)
set +e
snakemake -s __SNAKEFILE__ --directory __WORKDIR__ -j 100 --verbose __APPTAINER_PREFIX__ --profile config/__CLUSTER_PROFILE__
snakemake_rc=$?
set -e

kill "$_monitor_pid" 2>/dev/null || true
wait "$_monitor_pid" 2>/dev/null || true

if [[ "$snakemake_rc" -eq 0 ]]; then
  # On success, re-derive the final step count from Snakemake's own last
  # progress line and report it as N/N (100%, 0 remaining) rather than
  # whatever the monitor's last (up to 60s stale) snapshot said.
  final_content=""
  final_raw=$(grep -oP '[0-9]+ of [0-9]+ steps \([0-9]+%\) done' "__WORKDIR__/slurm-${SLURM_JOB_ID}.out" 2>/dev/null | tail -1 || true)
  if [[ -n "$final_raw" ]]; then
    final_total=$(printf '%s' "$final_raw" | grep -oP '(?<=of )\d+' || true)
    if [[ -n "$final_total" ]]; then
      final_content=$(printf 'Progress : %s / %s steps complete (100%%)\nRemaining: 0 steps\nUpdated  : %s\n' \
        "$final_total" "$final_total" "$(date '+%Y-%m-%d %H:%M:%S')")
    fi
  fi
  _write_pipeline_state_marker completed "snakemake_succeeded" "" "$final_content"
  echo "OK    [head_job] Snakemake completed successfully"
else
  # On failure, preserve whatever progress snapshot the monitor last wrote
  # (instead of losing it) so pipeline.failed shows how far the run got.
  last_progress=$(cat "__WORKDIR__/pipeline.running" 2>/dev/null || true)

  # Enrich pipeline.failed/pipeline.status.json with which job(s) failed --
  # see write_failure_helpers_lib/extract_failed_rules_digest (harold
  # wrapper) for how.
  failed_digest=""
  if declare -F extract_failed_rules_digest > /dev/null; then
    failed_digest=$(extract_failed_rules_digest "__WORKDIR__/slurm-${SLURM_JOB_ID}.out" || true)
  fi
  num_failed=0
  failed_rules_json="[]"
  combined_content="$last_progress"
  if [[ -n "$failed_digest" ]]; then
    num_failed=$(printf '%s\n' "$failed_digest" | grep -c .)
    json_parts=()
    while IFS= read -r dl; do
      [[ -n "$dl" ]] && json_parts+=("\"$(_json_escape "$dl")\"")
    done <<< "$failed_digest"
    failed_rules_json="[$(IFS=,; echo "${json_parts[*]}")]"
    combined_content="${combined_content}
${num_failed} job(s) failed:
${failed_digest}"
  fi

  _write_pipeline_state_marker failed "snakemake_failed" "" "$combined_content" "$num_failed" "$failed_rules_json"
  echo "ERROR [head_job] Snakemake failed (exit code ${snakemake_rc})"
  exit "$snakemake_rc"
fi
SBATCH_EOF

  # Replace placeholders with actual values, escaped for safe use as a sed
  # replacement (see sed_replacement_escape for why this matters).
  sed -i "s|__WORKDIR__|$(sed_replacement_escape "${WORKDIR}")|g" ${SBATCH_SCRIPT}
  sed -i "s|__SNAKEFILE__|$(sed_replacement_escape "${SNAKEFILE}")|g" ${SBATCH_SCRIPT}
  sed -i "s|__CLUSTER_PROFILE__|$(sed_replacement_escape "${CLUSTER_PROFILE}")|g" ${SBATCH_SCRIPT}
  sed -i "s|__VERSION__|$(sed_replacement_escape "${VERSION}")|g" ${SBATCH_SCRIPT}
  sed -i "s|__GIT_COMMIT_TAG__|$(sed_replacement_escape "${GIT_COMMIT_TAG}")|g" ${SBATCH_SCRIPT}
  if [[ -n "${APPTAINER_PREFIX_ARG}" ]]; then
    sed -i "s|__APPTAINER_PREFIX__|$(sed_replacement_escape "${APPTAINER_PREFIX_ARG}")|g" ${SBATCH_SCRIPT}
  else
    sed -i "s|__APPTAINER_PREFIX__||g" ${SBATCH_SCRIPT}
  fi
  if [[ -n "${PART_OPT}" ]]; then
    sed -i "s|__PART_OPTION__|$(sed_replacement_escape "#SBATCH ${PART_OPT}")|g" ${SBATCH_SCRIPT}
  else
    sed -i "s|__PART_OPTION__||g" ${SBATCH_SCRIPT}
  fi

  # Export singularity cache dir command (may be empty)
  if [[ -n "${EXPORT_SING_CACHE_DIR_CMD:-}" ]]; then
    python - "$SBATCH_SCRIPT" <<'PY'
import os
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text()
replacement = os.environ["EXPORT_SING_CACHE_DIR_CMD"]
path.write_text(text.replace("__EXPORT_SING_CACHE_CMD__", replacement, 1))
PY
  else
    sed -i "s|__EXPORT_SING_CACHE_CMD__||g" ${SBATCH_SCRIPT}
  fi

  # Insert PROFILE export (may be empty)
  if [[ -n "${EXPORT_PROFILE_CMD:-}" ]]; then
    sed -i "s|__EXPORT_PROFILE_CMD__|$(sed_replacement_escape "${EXPORT_PROFILE_CMD}")|g" ${SBATCH_SCRIPT}
  else
    sed -i "s|__EXPORT_PROFILE_CMD__||g" ${SBATCH_SCRIPT}
  fi

  # MODULE_LOAD may contain commands to load modules/conda. Place it into script if set.
  if [[ -n "${MODULE_LOAD:-}" ]]; then
    sed -i "s|__MODULE_LOAD_CMD__|$(sed_replacement_escape "${MODULE_LOAD}")|g" ${SBATCH_SCRIPT}
  else
    sed -i "s|__MODULE_LOAD_CMD__||g" ${SBATCH_SCRIPT}
  fi

  log_divider
  write_pipeline_state_marker running "submission_started"

  # Submit the head job to Slurm and capture job id
  if command -v sbatch &> /dev/null; then
    if ! JOBID=$(sbatch --parsable ${SBATCH_SCRIPT}); then
      write_pipeline_state_marker failed "sbatch_submission_failed"
      log_error "Failed to submit ${SBATCH_SCRIPT}"
      exit 1
    fi
    write_pipeline_state_marker running "sbatch_submitted" "${JOBID}"
    log_divider
    log_ok "Submitted head job as sbatch job ${JOBID}. Output: ${WORKDIR}/slurm-${JOBID}.out"
    log_next "Monitor:  squeue -u $USER"
    log_next "Progress: tail -f ${WORKDIR}/slurm-${JOBID}.out"
    log_next "Status:   ls -1 ${WORKDIR}/pipeline.*"
    log_next "Sidecar:  ${WORKDIR}/pipeline.status.json"
    log_divider
  else
    write_pipeline_state_marker failed "sbatch_not_found"
    err "sbatch not found in PATH; cannot submit head job to Slurm"
  fi

}

##########################################################################################
# CREATE RUNINFO ... create runinfo.yaml in workdir
##########################################################################################

function create_runinfo {
  modtime=$1
  if [ "$modtime" == "" ];then
   modtime=$(stat ${WORKDIR}/runinfo.yaml|grep Modify|awk '{print $2,$3}'|awk -F"." '{print $1}'|sed "s/ //g"|sed "s/-//g"|sed "s/://g")
  fi
  if [ -f ${WORKDIR}/runinfo.yaml ];then
    mv ${WORKDIR}/runinfo.yaml ${WORKDIR}/stats/runinfo.${modtime}.yaml
  fi
  echo "Pipeline Dir: $PIPELINE_HOME" > ${WORKDIR}/runinfo.yaml
  echo "Git Commit/Tag: $GIT_COMMIT_TAG" >> ${WORKDIR}/runinfo.yaml
  userlogin=$(whoami)
  if [[ `which finger 2>/dev/null` ]];then
	  username=$(finger $userlogin |grep ^Login | awk -F"Name: " '{print $2}');
  elif [[ `which getent 2>/dev/null` ]];then
    username=$(getent passwd $userlogin | awk -F":" '{print $5}' | awk '{$1=$1;print}');
  elif [[ `which lslogins 2>/dev/null` ]];then
	  username=$(lslogins -u $userlogin | grep ^Geco | awk -F": " '{print $2}' | awk '{$1=$1;print}');
  else username="";fi
  echo "Login: $userlogin" >> ${WORKDIR}/runinfo.yaml
  echo "Name: $username" >> ${WORKDIR}/runinfo.yaml
  g=$(groups)
  echo "Groups: $g" >> ${WORKDIR}/runinfo.yaml
  d=$(date)
  echo "Date/Time: $d" >> ${WORKDIR}/runinfo.yaml
}

