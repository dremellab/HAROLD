##########################################################################################
# RUN wrapper for all possible run's
# a. dryrun
# b. unlock
# c. local run
# d. slurm run, etc.
##########################################################################################

function run() {

  if [ "$1" == "local" ];then

    preruncleanup

    snakemake -s "$SNAKEFILE" \
      --directory "$WORKDIR" \
      -j 100 --verbose \
      ${APPTAINER_PREFIX_ARG} \
      --profile config/local

  elif [ "$1" == "slurm" ];then

    preruncleanup

    snakemake -s "$SNAKEFILE" \
      --directory "$WORKDIR" \
      -j 100 --verbose \
      ${APPTAINER_PREFIX_ARG} \
      --profile "config/${CLUSTER_PROFILE}"

  elif [ "$1" == "--touch" ];then

    snakemake "$1" -s "$SNAKEFILE" \
      --directory "$WORKDIR" \
      ${APPTAINER_PREFIX_ARG} \
      --cores 1

  else # dry-run and unlock

    preruncleanup

    snakemake -s "$SNAKEFILE" \
      --directory "$WORKDIR" \
      -j 100 --verbose \
      ${APPTAINER_PREFIX_ARG} \
      --profile "config/${CLUSTER_PROFILE}" \
      "$1"

  fi

}

##########################################################################################
# RESET ... delete workdir and then initialize
##########################################################################################

function reset() {
  #delete the workdir and re-initialize it
  log_info "Working Dir: $WORKDIR"
  if [ ! -d $WORKDIR ];then err "Folder $WORKDIR does not exist!";fi
  log_warn "Deleting $WORKDIR"
  rm -rf $WORKDIR
  log_step "Re-Initializing $WORKDIR"
  init
}

##########################################################################################
# MAIN ... command line argument parsing
##########################################################################################

function main(){

  if [ $# -eq 0 ]; then usage; exit 1; fi

  allargs="$@"

  for i in "$@"
  do
  case $i in
      -m=*|--runmode=*)
        RUNMODE="${i#*=}"
      ;;
      -w=*|--workdir=*)
        WORKDIR="${i#*=}"
      ;;
      -i=*|--sifdir=*)
        SIF_DIR_OVERRIDE="${i#*=}"
      ;;
      -g=*|--host=*)
        HOST="${i#*=}"
      ;;
      -a=*|--additives=*)
        ADDITIVES="${i#*=}"
      ;;
      -v=*|--viruses=*)
        VIRUSES="${i#*=}"
      ;;
      -s=*|--manifest=*)
        MANIFEST="${i#*=}"
        if [ ! -f $MANIFEST ];then err "File $MANIFEST does NOT exist!";fi
      ;;
      -x=*|--contrasts=*)
        CONTRASTS="${i#*=}"
        if [ ! -f $CONTRASTS ];then err "File $CONTRASTS does NOT exist!";fi
      ;;
      -h|--help)
        usage && exit 0;
      ;;
      -V|--version)
        echo "$VERSION"
        exit 0
      ;;
      *)
        err "Unknown argument $i!"    # unknown option
      ;;
  esac
  done

  WORKDIR=$(readlink -f $WORKDIR)
  log_info "Working Dir: $WORKDIR"
  CONFIGFILE="${WORKDIR}/config.yaml"

  SCRATCH_ROOT="${SCRATCH:-/scratch/$USER}"
  SCRATCH_FALLBACK="${WORKDIR}/.harold_runtime"
  if [[ ! -d "$SCRATCH_ROOT" ]]; then
    mkdir -p "$SCRATCH_ROOT" 2>/dev/null || SCRATCH_ROOT="$SCRATCH_FALLBACK"
  fi

  if [[ -n "${SIF_DIR_OVERRIDE:-}" ]]; then
    APPTAINER_SIF_DIR="$SIF_DIR_OVERRIDE"
  else
    APPTAINER_SIF_DIR="$DEFAULT_SHARED_SIF_DIR"
  fi

  export APPTAINER_SIF_DIR=$(readlink -f "$APPTAINER_SIF_DIR")
  export APPTAINER_CACHEDIR=$(readlink -f "$SINGULARITY_CACHEDIR")
  export APPTAINER_TMPDIR=$(readlink -f "$SINGULARITY_TMPDIR")
  export APPTAINER_PULLDIR=$(readlink -f "$SINGULARITY_PULLFOLDER")

  if [[ -n "$APPTAINER_SIF_DIR" ]]; then
    export APPTAINER_PREFIX_ARG="--apptainer-prefix=${APPTAINER_SIF_DIR}"
  else
    log_error "APPTAINER_SIF_DIR is not set!"
    exit 1
  fi

  EXPORT_SING_CACHE_DIR_CMD=$(
    cat <<EOF
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR}"
export APPTAINER_PULLDIR="${APPTAINER_PULLDIR}"
export APPTAINER_SIF_DIR="${APPTAINER_SIF_DIR}"
export APPTAINER_PREFIX_ARG="${APPTAINER_PREFIX_ARG}"
EOF
  )
  export EXPORT_SING_CACHE_DIR_CMD

  if [[ "$APPTAINER_SIF_DIR" == "$DEFAULT_SHARED_SIF_DIR" ]]; then
    warn_missing_shared_sifs "$CONFIGFILE" "$APPTAINER_SIF_DIR"
  fi

  # --contrasts can be supplied against an already-initialized workdir (eg. to turn on
  # diffex_deg_gsea after the fact) without needing to re-run init/reconfig.
  # For a fresh `-m=init`, WORKDIR does not exist yet here; init() copies it instead.
  if [ -n "$CONTRASTS" ] && [ -d "$WORKDIR" ]; then
    cp -L "$CONTRASTS" "$WORKDIR/contrasts.tsv"
    log_ok "Copied contrasts file to $WORKDIR/contrasts.tsv"
  fi

  case $RUNMODE in
    init) init && exit 0;;
    dryrun) dryrun && exit 0;;
    unlock) unlock && exit 0;;
    run) runslurm && exit 0;;
    runlocal) runlocal && exit 0;;
    reset) reset && exit 0;;
    touch) touch && exit 0;;
    dry) dryrun && exit 0;;                      # hidden option
    local) runlocal && exit 0;;                  # hidden option
    reconfig) reconfig && exit 0;;               # hidden option for debugging
    recluster) recluster && exit 0;;             # hidden option for debugging
    printbinds) printbinds && exit 0;;           # hidden option
    help) usage && exit 0;;                      # print help
    *) err "Unknown RUNMODE \"$RUNMODE\"";;
  esac
}

##########################################################################################
# run main!
##########################################################################################

main "$@"
