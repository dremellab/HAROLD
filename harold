}

##########################################################################################
# RECLUSTER ... update cluster related config files
##########################################################################################


function recluster(){

  log_step "[recluster] Syncing cluster config into workdir"
  # copy slurm config files to workdi
  for f in $(find ${PIPELINE_HOME}/config/ -type d -name "slurm*");do
