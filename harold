function check_essential_files() {
  if [ ! -d $WORKDIR ];then err "Folder $WORKDIR does not exist!"; fi
  for f in config.yaml samples.tsv; do
    if [ ! -f $WORKDIR/$f ]; then err "Error: '${f}' file not found in workdir ... initialize first!";fi
  done
}

function check_not_already_running() {
# Refuse to run while a prior run still looks active (or crashed without
# cleaning up) in this workdir -- submitting a second run, or unlocking the
# Snakemake lock, while one is genuinely still active can corrupt pipeline
# state. Called from run/runlocal (before submitting/starting) and unlock
# (before touching the Snakemake lock); dryrun/touch are read-only/inspection
# and must keep working while pipeline.running exists (see
# warn_if_already_running).
  if [ -f "${WORKDIR}/pipeline.running" ]; then
    err "Found ${WORKDIR}/pipeline.running -- a run already appears to be in progress (or a previous run crashed without cleaning up). Confirm no run is active, then remove this file before retrying."
  fi
}

function warn_if_already_running() {
# Unlike check_not_already_running, this does not abort -- dryrun is
# read-only/inspection and legitimately useful while a run is in progress.
# Banner styled after err() (below) so it can't be missed among dry-run
# output; unlike err() this warns rather than aborting.
  if [ -f "${WORKDIR}/pipeline.running" ]; then
    cat <<-EOF

#
# WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING
#
  Found ${WORKDIR}/pipeline.running -- a pipeline run may already be in
  progress (or a previous run crashed without cleaning up) in this workdir.
  'harold -m=run'/'runlocal'/'unlock' will refuse to proceed while this file
  exists.
#
# WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING WARNING
#

EOF
  fi
}


##########################################################################################
# RECONFIG ... recreate config.yaml and overwrite old version
##########################################################################################

function reconfig(){
  # rebuild config file and replace the config.yaml in the WORKDIR
  # this is only for dev purposes when new key-value pairs are being added to the config file
  log_step "[reconfig] Rebuilding config.yaml"
  check_essential_files
sed -e "
  s|PIPELINE_HOME|$PIPELINE_HOME|g;
  s|WORKDIR|$WORKDIR|g;
  s|HOST|$HOST|g;
