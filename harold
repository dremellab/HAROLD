##########################################################################################
# pipeline.* run-state markers + status sidecar
##########################################################################################

function json_escape() {
# Escape a string for safe embedding in a JSON string value.
# GIT_COMMIT_TAG embeds a literal tab (gid\ttag), which is an invalid raw
# control character inside a JSON string, so fold it (and any newline) to a
# space in addition to the usual backslash/quote escaping.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\t' '  '
}

function sed_replacement_escape() {
# Escape a value for safe use as the replacement side of `sed -i "s|placeholder|VALUE|g"`
# (used when templating the generated SBATCH script). Backslash must be escaped
# first, before & and the | delimiter, so the backslashes this inserts aren't
# themselves re-escaped by a later pass -- doing it in the other order (as a
# previous version of this script did for APPTAINER_PREFIX_ARG) silently
# corrupts any value containing a literal / or &.
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/[&|]/\\&/g'
}

function write_pipeline_state_marker() {
# Write a single state marker file (pipeline.<state>) and a JSON status
# sidecar (pipeline.status.json) in WORKDIR.
# Args: state reason [job_id] [content] [num_failed_rules] [failed_rules_json]
# NOTE: kept in sync with the embedded _write_pipeline_state_marker inside
# the SBATCH_SCRIPT heredoc below (runslurm()) -- that copy runs as a
# detached process on the SLURM head job and can't call back into this one,
# so any change here (especially to the two new failure-digest args) must be
# mirrored there too.
  local state="$1"
  local reason="${2:-}"
  local job_id="${3:-NA}"
  local content="${4:-}"
  local num_failed_rules="${5:-0}"
  local failed_rules_json="${6:-[]}"
  local now_utc
  local host
  local sidecar
  local sidecar_tmp

  now_utc=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  host=$(hostname 2>/dev/null || echo "unknown")
  sidecar="${WORKDIR}/pipeline.status.json"
  sidecar_tmp="${sidecar}.tmp.$$"

  # Create the new marker before removing the old ones, so there's never a
  # window with no pipeline.* marker present -- worst case is a brief window
  # with two (new + stale old), which is a safer failure mode for anything
  # polling pipeline.* than a window with none.
  # If content was supplied (e.g. a final/last-known progress summary), write
  # it into the marker instead of leaving the marker empty.
  if [[ -n "$content" ]]; then
    printf '%s' "$content" > "${WORKDIR}/pipeline.${state}"
  else
    : > "${WORKDIR}/pipeline.${state}"
  fi
  for other_state in running completed failed canceled; do
    [[ "${other_state}" == "${state}" ]] && continue
    rm -f "${WORKDIR}/pipeline.${other_state}"
  done

  cat > "$sidecar_tmp" << EOF
{
  "pipeline": "HAROLD",
  "version": "${VERSION}",
  "git_commit_tag": "$(json_escape "${GIT_COMMIT_TAG}")",
  "state": "$(json_escape "$state")",
  "reason": "$(json_escape "$reason")",
  "runmode": "$(json_escape "${RUNMODE:-unknown}")",
  "workdir": "$(json_escape "${WORKDIR}")",
  "slurm_job_id": "$(json_escape "$job_id")",
  "host": "$(json_escape "$host")",
  "num_failed_rules": ${num_failed_rules:-0},
  "failed_rules": ${failed_rules_json:-[]},
  "timestamp_utc": "${now_utc}"
}
EOF
  mv "$sidecar_tmp" "$sidecar"
  log_info "State marker updated: pipeline.${state} (reason=${reason}, slurm_job_id=${job_id})"
}

function write_failure_helpers_lib() {
# Writes the shared failed-job-digest parser to WORKDIR/.harold_failure_helpers.sh
# so both runlocal() (live bash, sources it directly) and the generated
# SBATCH_SCRIPT (a detached process that runs later, sources it at runtime)
# call the exact same implementation instead of hand-duplicating a complex
# parser -- see extract_failed_rules_digest for what it does and why. Cheap
# to write, so this is called unconditionally from runcheck() (every
# runmode); only run/runlocal ever actually source and call it.
  cat > "${WORKDIR}/.harold_failure_helpers.sh" << 'LIB_EOF'
#!/bin/bash

extract_failed_rules_digest() {
# Best-effort scrape of Snakemake's own log for "Error in rule" blocks --
# NOT authoritative (Snakemake's log wording could shift between versions),
# so a parse miss here must never block writing pipeline.failed. Verified
# against snakemake 9.9.0 + snakemake-executor-plugin-slurm 1.8.0:
#   - Job.log_error()/get_log_error_info() (snakemake/jobs.py) render a
#     failed job as:
#       Error in rule <name>:
#           message: <msg>
#           jobid: <internal_jobid>
#           input: ...
#           output: ...
#           log: <path> (check log file(s) for error details)
#           shell: ...
#     (snakemake/logging.py:_format_job_error).
#   - snakemake_executor_plugin_slurm's check_active_jobs() calls
#     report_job_error(j, msg="SLURM-job '<external_jobid>' failed, SLURM
#     status is: '<STATE>'. ", aux_logs=[<real per-job log path>]) as soon as
#     sacct reports a failed SLURM status for that job -- this fires
#     immediately per failed attempt, BEFORE Snakemake's scheduler decides
#     whether restart-times allows a retry (scheduler.py's _handle_error()).
#     Since this pipeline sets restart-times: 3, a job that fails and later
#     succeeds on retry still leaves a stray block here -- dedup by internal
#     jobid (stable across retries, unlike the external SLURM id) and drop
#     any jobid that later has a matching "Finished jobid: <id>" line
#     (scheduler.py) elsewhere in the log.
#   - The real per-job log path is embedded directly in the "log:" line via
#     aux_logs (almost no HAROLD rule declares its own `log:`), at
#     logs/{rule|group}_<name>/<wildcards>/<external_jobid>.log -- the
#     directory segment right before "<external_jobid>.log" IS the
#     sample/wildcards value (run_job() in the executor plugin), so it's read
#     straight out of the already-printed log path instead of needing a
#     separate `sacct` call.
#   - A job whose `sbatch` submission itself fails (cluster down, bad
#     request, etc.) never gets an external jobid or log path at all -- still
#     report it (slurm_job=NA, log=NA) rather than silently dropping it.
#   - No HAROLD rule currently uses `group:`, so grouped-job log/comment
#     conventions (which differ) are not handled here.
  local logfile="$1"
  [[ -f "$logfile" ]] || return 0

  local rule_re='^Error in rule (.+):$'
  local jobid_re='^    jobid: ([0-9]+)$'
  local message_re='^    message: (.*)$'
  local log_re='^    log: (.*) \(check log file\(s\) for error details\)$'
  local slurm_fail_re="SLURM-job '([0-9]+)' failed, SLURM status is: '([A-Za-z_]+)'"

  local -A last_rule=() last_extid=() last_state=() last_log=() last_sample=()
  local -A finished_jobids=()

  local fjid
  while IFS= read -r fjid; do
    [[ -n "$fjid" ]] && finished_jobids["$fjid"]=1
  done < <(grep -oP '(?<=Finished jobid: )[0-9]+' "$logfile" 2>/dev/null || true)

  local in_block=0 rule="" jobid="" message="" logline=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $rule_re ]]; then
      in_block=1
      rule="${BASH_REMATCH[1]}"
      jobid=""; message=""; logline=""
      continue
    fi
    if [[ "$in_block" -eq 1 ]]; then
      if [[ -z "$line" ]]; then
        if [[ -n "$jobid" ]]; then
          last_rule["$jobid"]="$rule"
          last_extid["$jobid"]="NA"
          last_state["$jobid"]="NA"
          last_log["$jobid"]="NA"
          last_sample["$jobid"]="NA"
          if [[ "$message" =~ $slurm_fail_re ]]; then
            last_extid["$jobid"]="${BASH_REMATCH[1]}"
            last_state["$jobid"]="${BASH_REMATCH[2]}"
          fi
          if [[ -n "$logline" ]]; then
            local first_log sample
            first_log="${logline%%,*}"
            first_log="${first_log# }"
            last_log["$jobid"]="$first_log"
            sample=$(basename "$(dirname "$first_log")" 2>/dev/null || true)
            [[ -n "$sample" ]] && last_sample["$jobid"]="$sample"
          fi
        fi
        in_block=0
        continue
      fi
      if [[ "$line" =~ $jobid_re ]]; then
        jobid="${BASH_REMATCH[1]}"
      elif [[ -z "$message" && "$line" =~ $message_re ]]; then
        message="${BASH_REMATCH[1]}"
      elif [[ -z "$logline" && "$line" =~ $log_re ]]; then
        logline="${BASH_REMATCH[1]}"
      fi
    fi
  done < "$logfile"

  local jid
  for jid in "${!last_rule[@]}"; do
    [[ -n "${finished_jobids[$jid]:-}" ]] && continue
    printf 'FAILED: rule=%s jobid=%s slurm_job=%s state=%s sample=%s log=%s\n' \
      "${last_rule[$jid]}" "$jid" "${last_extid[$jid]}" "${last_state[$jid]}" \
      "${last_sample[$jid]}" "${last_log[$jid]}"
  done
}
LIB_EOF
}

